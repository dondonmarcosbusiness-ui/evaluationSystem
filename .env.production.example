APP_NAME=NEUST Evaluation System
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://evaluation-CHANGE_ME.sslip.io

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database (docker compose substitutes these for the mariadb container too)
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=evaluation_system
DB_USERNAME=evaluation
DB_PASSWORD=CHANGE_ME
# Extra var used only by docker-compose.yaml for the mariadb root password
DB_ROOT_PASSWORD=CHANGE_ME_ROOT

# Demo runs jobs synchronously; uncomment the queue/schedule services in
# docker-compose.yaml and set QUEUE_CONNECTION=database for real background jobs.
QUEUE_CONNECTION=sync

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@neust.edu.ph
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (redirect must match: https://evaluation-CHANGE_ME.sslip.io/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://evaluation-CHANGE_ME.sslip.io/auth/google/callback

# Gemini AI (AI comment analysis / moderation)
GEMINI_API_KEY=

# Used by docker-compose.yaml to configure the Caddy HTTPS proxy
CADDY_DOMAIN=evaluation-CHANGE_ME.sslip.io
